# このファイルを secrets.toml という名前でコピーして使います。
# secrets.toml は .gitignore に入っているのでGitHubには上がりません。

# 管理者画面のパスワード
admin_password = "ここに好きなパスワード"

# クラウドDB（Supabase）を使う場合だけ書きます。書かなければPC内のファイルに保存されます。
[supabase]
url = "https://xxxxxxxxxxxx.supabase.co"

# ★ここは service_role キー（secret）を使います。anon キーではありません。
#   テーブルは行レベルセキュリティを有効にしてあり、anon キーでは何も読み書きできません。
#   service_role キーはサーバー側でしか使われず、ブラウザには送られません。
#   絶対に公開しないでください。
key = "eyJhbGciOi...（service_role キー）"
